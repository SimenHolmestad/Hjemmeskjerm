# Løkka som tar skjermbilde av sida og viser det på e-paper-skjermen.

[Unit]
Description=Hjemmeskjerm – e-paper-visning
After=hjemmeskjerm-web.service
Wants=hjemmeskjerm-web.service

[Service]
Type=simple
User=simen
WorkingDirectory=/home/simen/Hjemmeskjerm/eink/render
ExecStart=/home/simen/Hjemmeskjerm/eink/render/.venv/bin/python render.py
Restart=always
RestartSec=30
# Kjører som vanlig bruker. epaper krever root og kalles gjennom sudo
# (use_sudo i eink.toml), slik at nettleseren ikke kjører privilegert.
# Krever regla i /etc/sudoers.d/epaper – se README.
# render.py holder chromium i live mellom rundene; ta med hele treet ved stopp.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
